// Pipeline parameters configuration
params {
  // Input options
  sample_sheet = null              // TSV file with sample_id, bam_dir columns
  vireo_sample_sheet = null        // TSV file with sample_id, n_donors columns (optional)

  reference_genome = null
  reference_transcriptome = null
  canonical_barcode_list = null
  snp_annotation = null            // VCF file with SNP positions for genotyping (optional)
  output_dir = "output"

  alignment {
    bam_parts = 32
  }

  barcode_detection {
    min_barcode_count = 500          // Minimum read count for a barcode to be included
    chemistry = '3v3'                // 10X Chromium chemistry: 3v1, 3v2, 3v3, 3v3.1, 3v4, 5v1, 5v2, 5v3
  }

  // Control what gets published to output directory
  publish {
    // Intermediate files (usually disabled for production runs)
    fastq = false                    // BAM to FASTQ converted files
    retagged_fastq = true           // Retagged FASTQ files with barcode/UMI tags
    flexiplex_candidates = false     // Individual barcode candidate files per sample

    // Important intermediate results (enabled by default)
    flexiplex_merged = true          // Merged barcode list across all samples
    flexiplex_logs = true            // Flexiplex tagging log files
    splice_aligned = true            // Splice-aligned BAM files

    // Final results (always enabled)
    oarfish = true                   // Oarfish quantification results
    cell_snp = true                  // CellSNP genotyping results
    vireo = true                     // Vireo demultiplexing results

    // Utility outputs
    bcl2fastq = false                // BCL to FASTQ conversion results
  }
}
