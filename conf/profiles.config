// Profiles configuration
// Usage: nextflow run main.nf -profile <profile_name>
//
// Available profiles:
//   - docker (default): Local execution with Docker
//   - singularity: Local execution with Singularity
//   - slurm_docker: SLURM cluster with Docker
//   - slurm_singularity: SLURM cluster with Singularity (recommended for HPC)

profiles {
    // Default profile: Local execution with Docker
    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.executor = 'local'
        cleanup = false
    }

    // Local execution with Singularity
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
        process {
            executor = 'local'
            container = 'oras://ghcr.io/shians/lupus-workflow-container:latest-singularity'
        }
        cleanup = false
    }

    // SLURM cluster with Docker
    slurm_docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process {
            executor = 'slurm'
            memory = '32.GB'
            cpus = 8
            time = '24h'
        }
        cleanup = false
    }

    // SLURM cluster with Singularity (recommended for HPC)
    slurm_singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
        process {
            executor = 'slurm'
            memory = '32.GB'
            cpus = 8
            time = '24h'
            container = 'oras://ghcr.io/shians/lupus-workflow-container:latest-singularity'
        }
        cleanup = false
    }

    // Local execution with Podman
    podman {
        podman {
            enabled = true
        }
        process.executor = 'local'
        cleanup = false
    }

    // SLURM cluster with Podman
    slurm_podman {
        podman {
            enabled = true
        }
        process {
            executor = 'slurm'
            memory = '32.GB'
            cpus = 8
            time = '24h'
        }
        cleanup = false
    }
}
