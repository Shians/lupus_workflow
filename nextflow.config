// Parameters
params {
  // Input options
  sample_sheet = null              // TSV file with sample_id, bam_dir columns
  vireo_sample_sheet = null        // TSV file with sample_id, n_donors columns (optional)

  reference_genome = null
  reference_transcriptome = null
  canonical_barcode_list = null
  snp_annotation = null            // VCF file with SNP positions for genotyping (optional)
  chemistry = null                 // 10X Chromium chemistry: 3v1, 3v2, 3v3, 3v3.1, 3v4, 5v1, 5v2, 5v3
  output_dir = "output"

  bam_parts = 32                        // Number of FASTQ chunks per sample for parallel alignment

  // CellSNP genotyping parallelism (see modules/demultiplexing/main.nf):
  //   cellsnp-lite in target mode runs one thread per chromosome, so a single
  //   monolithic job leaves cores idle and is dominated by the largest contig.
  //   Sharding splits the target SNP VCF into many balanced chunks run as
  //   independent, right-sized array jobs, then merges into one cellSNP dir.
  cellsnp_sharded = true                // Toggle sharded (default) vs single-job (false) cellSNP path
  cellsnp_chunks  = 64                  // Number of target-VCF shards when cellsnp_sharded = true

  // Two caps passed to cellsnp-lite, bounding two different quantities. Both
  // default to 0 (= unlimited) in cellsnp-lite itself, which is what allowed the
  // OOMs. Set either to 0 here to restore that default.
  //
  // The distinction is load-bearing, because only one of them bounds memory.
  // htslib's pileup queue holds a read from its leftmost start to its rightmost
  // end regardless of CIGAR, so a spliced long read spanning a 100 kb intron
  // occupies the queue across all 100 kb, appearing at intronic positions as a
  // refskip. Queue size therefore tracks SPAN depth, not base depth:
  //
  //   --maxPILEUP  counts reads in the queue, including filtered and refskip
  //                reads. This is the span-depth quantity, so this is the flag
  //                that actually bounds peak RSS.
  //   --maxDEPTH   counts reads contributing a base at the site, after filters.
  //                This is the signal quantity -- what lands in AD/DP.
  //
  // Since pileup >= depth always, --maxDEPTH alone does NOT bound the queue: at
  // a site where millions of reads span the position but only a few thousand
  // carry a base there, --maxDEPTH never trips while the queue still blows up.
  // Measured on the 150 deepest sites at -p 4, everything else held fixed:
  //
  //   uncapped                        35.31 GB   1833s
  //   --maxDEPTH 8000                 34.34 GB   1637s
  //   --maxPILEUP 8000                 0.41 GB    220s
  //
  // Span depths measured over all 37,052,266 candidate sites, back when
  // computeTargetDepth still ran --fast-mode (it no longer does -- see the
  // commentary there -- so these numbers are a historical measurement, not
  // something the pipeline reproduces):
  //
  //   median 13 | mean 1,222 | max 4,110,082
  //   >= 1M: 357 sites | >= 500k: 2,784 | >= 100k: 31,419 | >= 20k: 356,290
  //
  // The deepest sites are ACTB (chr7:5.64 Mb) and GAPDH (chr12:6.5 Mb) -- real
  // expression, not mapping artefacts. At ~1.6 KB per bam1_t a 4.1M-read queue
  // is ~6.6 GB in one thread at one position, and 150 such sites alone exceeded
  // the entire 32 GB request while 3,213 ordinary chr21 sites peaked at 0.61 GB.
  // The round-robin split in use at the time spread them evenly, so every chunk
  // drew ~5-6 sites above 1M -- which is why the whole array clustered at
  // 26-32 GB rather than a couple of unlucky outliers, and why splitting the
  // target list could not fix it.
  //
  // maxPILEUP 500,000: ~800 MB per thread, truncating the queue at only 2,784 of
  //   37M sites (0.0075%). UNMEASURED at this value -- the table above is at
  //   8,000, which cut memory 86x and wall 8.3x but also cut non-zero cell x
  //   site entries from 259,866 to 32,007 (an 88% loss of exactly the per-cell
  //   signal Vireo and the escape analysis consume). 500,000 leaves ~12 reads
  //   per cell at the deepest sites where 8,000 leaves ~0.2. Measure both peak
  //   RSS and the DP non-zero count here before trusting it.
  // maxDEPTH 1,000,000: deliberately generous, and expected to essentially never
  //   bind once maxPILEUP is set. It is NOT sized for Vireo, which only needs a
  //   pooled per-site allele fraction and would be served by ~8000. The same
  //   matrices feed allele-specific expression work (X-inactivation escape),
  //   which needs per-cell AD/DP, and these caps are POOLED budgets shared by
  //   every barcode: at 41k cells an 8000 cap would leave ~0.19 reads per cell
  //   wherever it engaged, against the ~5-10 reads per cell per site needed to
  //   separate monoallelic from biallelic expression. Truncation is also not
  //   barcode-stratified, so what it costs is whole cells, not depth shed
  //   evenly. Size this for the per-cell assay, not for demultiplexing.
  //
  // Caveat on maxPILEUP: because it counts refskip reads that carry no base at
  // the site, truncating the queue at an exonic SNP inside a long spliced gene
  // can evict informative reads in favour of intron-spanning ones. Check whether
  // any X-linked escape targets sit among those 2,784 deepest-span sites before
  // trusting their per-cell counts.
  cellsnp_max_depth  = 1000000
  cellsnp_max_pileup = 500000

  // Depth pre-filter for the cellSNP target list (see computeTargetDepth /
  // filterTargetsByDepth in modules/demultiplexing): a cheap mosdepth pass
  // per sample drops target sites with no meaningful coverage in ANY sample
  // before the expensive per-cell cellSNP pileup runs, without touching sites
  // by population allele frequency (so curated/GWAS loci with real coverage
  // are never dropped just for being rare). It runs unconditionally.
  min_target_depth = 20                 // Minimum read depth for a site to survive the filter; matches the minCOUNT floor in cellsnpDonorFilters

  // Tripwire, not a quality bar. Too few sites does not make Vireo fail, it
  // makes Vireo quietly unreliable, so the run stops instead. A genome-wide
  // list should clear this by two or three orders of magnitude -- a healthy run
  // here retained ~14M of 37M candidates even under the old, over-permissive
  // filter. Tripping it means shallow libraries, a contig or coordinate
  // mismatch between the target VCF and the aligned reference, or a target list
  // that does not suit the data; it is a signal to investigate, not to lower.
  //
  // Set well below any plausible healthy value so it never fires spuriously. If
  // you genotype against a small curated panel rather than a genome-wide list,
  // this needs lowering to match the panel.
  min_target_sites = 10000

  // Deduplication method:
  //   'nailpolish' - molecular (CB+UMI) consensus dedup at the FASTQ level (default)
  //   'umitools'   - legacy post-alignment position-based dedup (for validation)
  dedup_method = 'nailpolish'

  min_barcode_count = 500               // Minimum read count for a barcode to be retained

  // Control what gets published to output directory
  // Intermediate files (usually disabled for production runs)
  publish_fastq = false                 // BAM to FASTQ converted files
  publish_retagged_fastq = true         // Retagged FASTQ files with barcode/UMI tags
  publish_flexiplex_candidates = false  // Individual barcode candidate files per sample

  // Important intermediate results (enabled by default)
  publish_flexiplex_merged = true       // Merged barcode list across all samples
  publish_flexiplex_logs = true         // Flexiplex tagging log files
  publish_splice_aligned = true         // Splice-aligned BAM files
  publish_bam_dedup = false             // UMI-deduplicated BAM files (umitools mode)
  publish_dedup_fastq = false           // nailpolish-deduplicated FASTQ files

  // Final results (always enabled)
  publish_oarfish = true                // Oarfish quantification results
  publish_cell_snp = true              // CellSNP genotyping results
  publish_vireo = true                  // Vireo demultiplexing results

  // QC outputs
  publish_qc_cramino        = true
  publish_qc_flagstat       = true
  publish_qc_mosdepth       = true
  publish_qc_dedup_logs     = true
  publish_qc_knee_plots     = true
  publish_qc_read_tracking  = true
  publish_qc_multiqc        = true
}

// Parameter validation
plugins {
    id 'nf-schema@2.3.0'
}

validation {
    help {
        enabled = true
        showHidden = false
    }
    parametersSchema = 'nextflow_schema.json'
    monochromeLogs = false
    failUnrecognisedParams = true
    lenientMode = false
}

// Container and resource tiers
process {
    container = 'ghcr.io/shians/lupus-workflow-container:latest'

    withLabel: tiny {
        cpus   = 2
        memory = '8.GB'
        time   = '2h'
    }
    withLabel: small {
        cpus   = 4
        memory = '16.GB'
        time   = '12h'
    }
    withLabel: medium {
        cpus   = 8
        memory = '64.GB'
        time   = '24h'
    }
    withLabel: large {
        cpus   = 32
        memory = '256.GB'
        time   = '48h'
    }

    // Right-sized tier for per-shard cellSNP array jobs. Parallelism comes from
    // job count, not intra-job threads, so keep cpus low.
    //
    // cpus is 2, not 8, because the split is contiguous (see
    // split_cellsnp_targets.py). cellsnp-lite parallelises by chromosome, so a
    // shard covering one contiguous interval -- usually a fraction of one
    // chromosome -- cannot put many threads to work no matter what -p says. The
    // old round-robin split was what made 8 threads usable, by giving every
    // shard all 24 chromosomes, and it paid for that with a whole-BAM traversal
    // per shard. Shard count buys the parallelism instead.
    //
    // Not 1, though. Across a full 64-shard array 22 tasks exceeded 100% CPU and
    // 8 exceeded 130%, including the slowest task in the array (236 min at
    // 133%). Those are the shards straddling a contig boundary, and starving
    // them would stretch the critical path by roughly a third. An earlier
    // revision set cpus = 1 on the strength of four adjacent single-contig
    // shards all sitting at ~98%; that sample was not representative.
    //
    // Peak RSS per shard is essentially just the pileup queues: cpus x
    // cellsnp_max_pileup x ~1.6 KB, plus ~1 GB baseline.
    //
    // There is no meaningful per-cell term. That was measured directly, holding
    // everything else fixed: 4,000 barcodes gave 0.59 GB and 41,259 gave
    // 0.61 GB. The dense per-cell --genotype VCF is not a memory driver, and
    // barcode count does not belong in this sizing at all. An earlier revision
    // of this comment asserted the opposite and held the tier at 64 GB on that
    // basis -- it was wrong.
    //
    // Historical: at 8 cpus / 32 GB with uncapped queues and a round-robin
    // split, median RSS was 26.7 GiB across 56 shards with two OOM-killed at
    // 31.4 GiB. All of that was queue, concentrated in a handful of extreme
    // sites -- 150 of them alone peaked at 35.3 GB with -p 4, while 3,213
    // ordinary chr21 sites peaked at 0.61 GB.
    //
    // 8 GB against a full-array measurement of 1.0-3.7 GB peak RSS at cpus = 2,
    // i.e. ~2.2x headroom on the worst shard. Not trimmed further because that
    // margin is already modest and the tier retries on OOM anyway.
    withLabel: cellsnp_chunk {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = '12h'
    }

    withLabel: tiny_x4cpu {
        cpus   = 8
        memory = '8.GB'
        time   = '2h'
    }
    withLabel: small_x4cpu {
        cpus   = 16
        memory = '16.GB'
        time   = '12h'
    }
    withLabel: medium_x4cpu {
        cpus   = 32
        memory = '64.GB'
        time   = '24h'
    }

    // Process specific overrides for right-sizing. These are based on profiling and may be updated in the future.
    withName: flexiplexTagFastq {
        cpus   = 32
        memory = '12.GB'
    }
    withName: runOarfish {
        cpus   = 32
        memory = { 16.GB * task.attempt }
    }
    withName: craminoStats {
        cpus   = 8
        memory = '8.GB'
    }
    withName: sortBamByCellBarcode {
        cpus   = 32
        memory = '32.GB'
    }

    // Memory specific overrides for right-sizing. These are based on profiling and may be updated in the future.
    withName: 'countRawReads|countBarcodeTaggedReads|countGenomeAlignedReads|countGenomeDedupReads' { memory = '2.GB' }  // ~7 MB RSS each
    withName: 'countTranscriptAlignedReads|countTranscriptDedupReads' { memory = '2.GB' }
    // Streams the tagged FASTQ through pigz | wc, so RSS is a decompression
    // buffer regardless of file size; the cpus are what make it not slow.
    withName: countFastqReads           { memory = '2.GB'  }
    withName: readCountSummary          { memory = '2.GB'  }
    withName: aggregateReadTracking     { memory = '2.GB'  }
    withName: samtoolsFlagstat          { memory = '2.GB'  }
    withName: mosdepthCoverage          { memory = '4.GB'  }
    withName: multiQC                   { memory = '4.GB'  }
    withName: bamToFastq                { memory = '4.GB'  }
    withName: catTranscriptAlignedBams  { memory = '2.GB'  }
    withName: mergeSpliceAlignedBams    { memory = '4.GB'  }
    withName: indexBam                  { memory = '2.GB'  }
    withName: splitFastqChunks          { memory = '4.GB'  }
    withName: flexiplexGetBarcodeCandidates { memory = '4.GB' }
    withName: sortIndexBam              { memory = '12.GB' }
    withName: alignMinimap2Spliced      { memory = '48.GB' }
    withName: alignMinimap2TranscriptomeUnsorted { memory = '8.GB' }
    withName: buildMinimapIndexGenome   { memory = '32.GB' }
    withName: buildMinimapIndexTranscriptome { memory = '4.GB' }
    // cellsnp-lite holds a pileup buffer per thread, so peak RSS scales with
    // -p. Both cpus and memory are set here explicitly rather than inheriting a
    // mismatched pair from `label 'large'`.
    //
    // Sizing is cpus x cellsnp_max_pileup x ~1.6 KB, so ~12.8 GB expected here.
    // The "GB per thread" framing an earlier revision of this comment used came
    // from uncapped runs, where the multiplier was the deepest site in the list
    // rather than anything configurable; with maxPILEUP set it no longer means
    // anything. Cell count does not enter -- see the measurement cited on the
    // cellsnp_chunk tier above.
    //
    // maxPILEUP 500,000 has now been measured, but only on the sharded path: at
    // cpus = 2 those shards peaked at 2.0-2.6 GB, i.e. ~1 GB baseline on top of
    // the queue term. Extrapolating to 16 threads gives ~14 GB here, so 128 GB
    // is roughly 9x over -- far looser than the chunk tier's ~3x, and left that
    // way only because this path has never been observed running, let alone
    // failing. Measure it before trusting the extrapolation; cellsnp-lite's
    // per-chromosome threading means 16 threads may not behave like 8 shards.
    //
    // NOTE: withName overrides withLabel, so these values are what SLURM sees.
    // NOTE: attempt 3 requests 384 GB, which may exceed your largest node -- the
    // `large` tier tops out at 256 GB. If that attempt sits unschedulable in the
    // queue, cap this rather than raising maxRetries.
    withName: runCellSNPGenotype {
        cpus   = 16
        memory = { 128.GB * task.attempt }
        time   = '48h'
    }
    withName: umitoolsDedupTranscriptome { memory = '64.GB' }
    withName: umitoolsDedupGenome       { memory = '256.GB' }

    // cellsnp-lite peak RSS depends on the deepest pileup in the target list,
    // which is not known ahead of the run, so retry the OOM/kill exit codes
    // against the escalating memory declared above rather than failing the
    // pipeline. (Not cell count -- that was measured and does not matter.)
    // 137 is the SLURM cgroup OOM-kill; 140 is the SLURM time/limit kill.
    withName: 'runCellSNPGenotype|runCellSNPGenotypeChunk' {
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
}

// Reporting
timeline {
    enabled = true
    file    = "${params.output_dir}/logs/runtime_reports/lupus_workflow_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.output_dir}/logs/runtime_reports/lupus_workflow_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.output_dir}/logs/runtime_reports/lupus_workflow_trace.txt"
    overwrite = true
}

// Profiles
// Usage: nextflow run main.nf -profile <profile_name>
//
// Available profiles:
//   - docker: Local execution with Docker
//   - singularity: Local execution with Singularity
//   - slurm_docker: SLURM cluster with Docker
//   - slurm_singularity: SLURM cluster with Singularity (recommended for HPC)
//   - podman: Local execution with Podman
//   - slurm_podman: SLURM cluster with Podman
profiles {
    docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.executor = 'local'
        cleanup = false
    }

    singularity {
        singularity {
            enabled    = true
            autoMounts = true
        }
        process {
            executor  = 'local'
            container = 'oras://ghcr.io/shians/lupus-workflow-container:latest-singularity'
        }
        cleanup = false
    }

    slurm_docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.executor = 'slurm'
        cleanup = false
    }

    slurm_singularity {
        singularity {
            enabled    = true
            autoMounts = true
        }
        process {
            executor  = 'slurm'
            container = 'oras://ghcr.io/shians/lupus-workflow-container:latest-singularity'
        }
        cleanup = false
    }

    podman {
        podman {
            enabled = true
        }
        process.executor = 'local'
        cleanup = false
    }

    slurm_podman {
        podman {
            enabled = true
        }
        process.executor = 'slurm'
        cleanup = false
    }
}

manifest.defaultBranch = 'main'
