// Parameters
params {
  // Input options
  sample_sheet = null              // TSV file with sample_id, bam_dir columns
  vireo_sample_sheet = null        // TSV file with sample_id, n_donors columns (optional)

  reference_genome = null
  reference_transcriptome = null
  canonical_barcode_list = null
  snp_annotation = null            // VCF file with SNP positions for genotyping (optional)
  chemistry = null                 // 10X Chromium chemistry: 3v1, 3v2, 3v3, 3v3.1, 3v4, 5v1, 5v2, 5v3
  output_dir = "output"

  bam_parts = 32                        // Number of FASTQ chunks per sample for parallel alignment

  // Deduplication method:
  //   'nailpolish' - molecular (CB+UMI) consensus dedup at the FASTQ level (default)
  //   'umitools'   - legacy post-alignment position-based dedup (for validation)
  dedup_method = 'nailpolish'

  min_barcode_count = 500               // Minimum read count for a barcode to be retained

  // Control what gets published to output directory
  // Intermediate files (usually disabled for production runs)
  publish_fastq = false                 // BAM to FASTQ converted files
  publish_retagged_fastq = true         // Retagged FASTQ files with barcode/UMI tags
  publish_flexiplex_candidates = false  // Individual barcode candidate files per sample

  // Important intermediate results (enabled by default)
  publish_flexiplex_merged = true       // Merged barcode list across all samples
  publish_flexiplex_logs = true         // Flexiplex tagging log files
  publish_splice_aligned = true         // Splice-aligned BAM files
  publish_bam_dedup = false             // UMI-deduplicated BAM files (umitools mode)
  publish_dedup_fastq = false           // nailpolish-deduplicated FASTQ files

  // Final results (always enabled)
  publish_oarfish = true                // Oarfish quantification results
  publish_cell_snp = true              // CellSNP genotyping results
  publish_vireo = true                  // Vireo demultiplexing results

  // QC outputs
  publish_qc_cramino        = true
  publish_qc_flagstat       = true
  publish_qc_mosdepth       = true
  publish_qc_dedup_logs     = true
  publish_qc_knee_plots     = true
  publish_qc_read_tracking  = true
  publish_qc_multiqc        = true
}

// Parameter validation
plugins {
    id 'nf-schema@2.3.0'
}

validation {
    help {
        enabled = true
        showHidden = false
    }
    parametersSchema = 'nextflow_schema.json'
    monochromeLogs = false
    failUnrecognisedParams = true
    lenientMode = false
}

// Container and resource tiers
process {
    container = 'ghcr.io/shians/lupus-workflow-container:latest'

    withLabel: tiny {
        cpus   = 2
        memory = '8.GB'
        time   = '2h'
    }
    withLabel: small {
        cpus   = 4
        memory = '16.GB'
        time   = '12h'
    }
    withLabel: medium {
        cpus   = 8
        memory = '64.GB'
        time   = '24h'
    }
    withLabel: large {
        cpus   = 32
        memory = '256.GB'
        time   = '48h'
    }

    withLabel: tiny_x4cpu {
        cpus   = 8
        memory = '8.GB'
        time   = '2h'
    }
    withLabel: small_x4cpu {
        cpus   = 16
        memory = '16.GB'
        time   = '12h'
    }
    withLabel: medium_x4cpu {
        cpus   = 32
        memory = '64.GB'
        time   = '24h'
    }
    withLabel: large_x4cpu {
        cpus   = 128
        memory = '256.GB'
        time   = '48h'
    }
}

// Reporting
timeline {
    enabled = true
    file    = "${params.output_dir}/logs/runtime_reports/lupus_workflow_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.output_dir}/logs/runtime_reports/lupus_workflow_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.output_dir}/logs/runtime_reports/lupus_workflow_trace.txt"
    overwrite = true
}

// Profiles
// Usage: nextflow run main.nf -profile <profile_name>
//
// Available profiles:
//   - docker: Local execution with Docker
//   - singularity: Local execution with Singularity
//   - slurm_docker: SLURM cluster with Docker
//   - slurm_singularity: SLURM cluster with Singularity (recommended for HPC)
//   - podman: Local execution with Podman
//   - slurm_podman: SLURM cluster with Podman
profiles {
    docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.executor = 'local'
        cleanup = false
    }

    singularity {
        singularity {
            enabled    = true
            autoMounts = true
        }
        process {
            executor  = 'local'
            container = 'oras://ghcr.io/shians/lupus-workflow-container:latest-singularity'
        }
        cleanup = false
    }

    slurm_docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.executor = 'slurm'
        cleanup = false
    }

    slurm_singularity {
        singularity {
            enabled    = true
            autoMounts = true
        }
        process {
            executor  = 'slurm'
            container = 'oras://ghcr.io/shians/lupus-workflow-container:latest-singularity'
        }
        cleanup = false
    }

    podman {
        podman {
            enabled = true
        }
        process.executor = 'local'
        cleanup = false
    }

    slurm_podman {
        podman {
            enabled = true
        }
        process.executor = 'slurm'
        cleanup = false
    }
}

manifest.defaultBranch = 'main'
