// Parameters
params {
  // Input options
  sample_sheet = null              // TSV file with sample_id, bam_dir columns
  vireo_sample_sheet = null        // TSV file with sample_id, n_donors columns (optional)

  reference_genome = null
  reference_transcriptome = null
  canonical_barcode_list = null
  snp_annotation = null            // VCF file with SNP positions for genotyping (optional)
  chemistry = null                 // 10X Chromium chemistry: 3v1, 3v2, 3v3, 3v3.1, 3v4, 5v1, 5v2, 5v3
  output_dir = "output"

  bam_parts = 32                        // Number of FASTQ chunks per sample for parallel alignment

  // CellSNP genotyping parallelism (see modules/demultiplexing/main.nf):
  //   cellsnp-lite in target mode runs one thread per chromosome, so a single
  //   monolithic job leaves cores idle and is dominated by the largest contig.
  //   Sharding splits the target SNP VCF into many balanced chunks run as
  //   independent, right-sized array jobs, then merges into one cellSNP dir.
  cellsnp_sharded = true                // Toggle sharded (default) vs single-job (false) cellSNP path
  cellsnp_chunks  = 64                  // Number of target-VCF shards when cellsnp_sharded = true

  // Deduplication method:
  //   'nailpolish' - molecular (CB+UMI) consensus dedup at the FASTQ level (default)
  //   'umitools'   - legacy post-alignment position-based dedup (for validation)
  dedup_method = 'nailpolish'

  min_barcode_count = 500               // Minimum read count for a barcode to be retained

  // Control what gets published to output directory
  // Intermediate files (usually disabled for production runs)
  publish_fastq = false                 // BAM to FASTQ converted files
  publish_retagged_fastq = true         // Retagged FASTQ files with barcode/UMI tags
  publish_flexiplex_candidates = false  // Individual barcode candidate files per sample

  // Important intermediate results (enabled by default)
  publish_flexiplex_merged = true       // Merged barcode list across all samples
  publish_flexiplex_logs = true         // Flexiplex tagging log files
  publish_splice_aligned = true         // Splice-aligned BAM files
  publish_bam_dedup = false             // UMI-deduplicated BAM files (umitools mode)
  publish_dedup_fastq = false           // nailpolish-deduplicated FASTQ files

  // Final results (always enabled)
  publish_oarfish = true                // Oarfish quantification results
  publish_cell_snp = true              // CellSNP genotyping results
  publish_vireo = true                  // Vireo demultiplexing results

  // QC outputs
  publish_qc_cramino        = true
  publish_qc_flagstat       = true
  publish_qc_mosdepth       = true
  publish_qc_dedup_logs     = true
  publish_qc_knee_plots     = true
  publish_qc_read_tracking  = true
  publish_qc_multiqc        = true
}

// Parameter validation
plugins {
    id 'nf-schema@2.3.0'
}

validation {
    help {
        enabled = true
        showHidden = false
    }
    parametersSchema = 'nextflow_schema.json'
    monochromeLogs = false
    failUnrecognisedParams = true
    lenientMode = false
}

// Container and resource tiers
process {
    container = 'ghcr.io/shians/lupus-workflow-container:latest'

    withLabel: tiny {
        cpus   = 2
        memory = '8.GB'
        time   = '2h'
    }
    withLabel: small {
        cpus   = 4
        memory = '16.GB'
        time   = '12h'
    }
    withLabel: medium {
        cpus   = 8
        memory = '64.GB'
        time   = '24h'
    }
    withLabel: large {
        cpus   = 32
        memory = '256.GB'
        time   = '48h'
    }

    // Right-sized tier for per-shard cellSNP array jobs. cellsnp-lite peak RSS
    // is ~8 GB, so 16 GB is safe headroom; parallelism comes from job count,
    // not intra-job threads, so keep cpus low. Memory escalates on retry
    // because peak RSS varies with per-shard depth.
    withLabel: cellsnp_chunk {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '4h'
    }

    withLabel: tiny_x4cpu {
        cpus   = 8
        memory = '8.GB'
        time   = '2h'
    }
    withLabel: small_x4cpu {
        cpus   = 16
        memory = '16.GB'
        time   = '12h'
    }
    withLabel: medium_x4cpu {
        cpus   = 32
        memory = '64.GB'
        time   = '24h'
    }

    // Process specific overrides for right-sizing. These are based on profiling and may be updated in the future.
    withName: flexiplexTagFastq {
        cpus   = 32
        memory = '12.GB'
    }
    withName: runOarfish {
        cpus   = 32
        memory = '4.GB'
    }
    withName: craminoStats {
        cpus   = 8
        memory = '8.GB'
    }
    withName: sortBamByCellBarcode {
        cpus   = 32
        memory = '32.GB'
    }

    // Memory specific overrides for right-sizing. These are based on profiling and may be updated in the future.
    withName: 'countRawReads|countBarcodeTaggedReads|countGenomeAlignedReads|countGenomeDedupReads' { memory = '2.GB' }  // ~7 MB RSS each
    withName: readCountSummary          { memory = '2.GB'  }
    withName: samtoolsFlagstat          { memory = '2.GB'  }
    withName: mosdepthCoverage          { memory = '4.GB'  }
    withName: multiQC                   { memory = '4.GB'  }
    withName: bamToFastq                { memory = '4.GB'  }
    withName: catTranscriptAlignedBams  { memory = '2.GB'  }
    withName: combineMergedSplicedBams  { memory = '4.GB'  }
    withName: mergeSpliceAlignedBams    { memory = '4.GB'  }
    withName: indexBam                  { memory = '2.GB'  }
    withName: splitFastqChunks          { memory = '4.GB'  }
    withName: flexiplexGetBarcodeCandidates { memory = '4.GB' }
    withName: sortIndexBam              { memory = '12.GB' }
    withName: alignMinimap2Spliced      { memory = '48.GB' }
    withName: alignMinimap2TranscriptomeUnsorted { memory = '8.GB' }
    withName: buildMinimapIndexGenome   { memory = '32.GB' }
    withName: buildMinimapIndexTranscriptome { memory = '4.GB' }
    // cellsnp-lite holds a pileup buffer per thread, so peak RSS scales with
    // -p. The cellsnp_chunk tier measures ~8 GB at 4 threads; this monolithic
    // job runs many more, so both cpus and memory are set here explicitly
    // rather than inheriting a mismatched pair from `label 'large'`.
    // NOTE: withName overrides withLabel, so these values are what SLURM sees.
    withName: runCellSNPGenotype {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = '48h'
    }
    withName: umitoolsDedupTranscriptome { memory = '64.GB' }
    withName: umitoolsDedupGenome       { memory = '256.GB' }

    // cellsnp-lite peak RSS depends on per-sample cell count and depth, which
    // are not known ahead of the run, so retry the OOM/kill exit codes against
    // the escalating memory declared above rather than failing the pipeline.
    // 137 is the SLURM cgroup OOM-kill; 140 is the SLURM time/limit kill.
    withName: 'runCellSNPGenotype|runCellSNPGenotypeChunk' {
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
}

// Reporting
timeline {
    enabled = true
    file    = "${params.output_dir}/logs/runtime_reports/lupus_workflow_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.output_dir}/logs/runtime_reports/lupus_workflow_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.output_dir}/logs/runtime_reports/lupus_workflow_trace.txt"
    overwrite = true
}

// Profiles
// Usage: nextflow run main.nf -profile <profile_name>
//
// Available profiles:
//   - docker: Local execution with Docker
//   - singularity: Local execution with Singularity
//   - slurm_docker: SLURM cluster with Docker
//   - slurm_singularity: SLURM cluster with Singularity (recommended for HPC)
//   - podman: Local execution with Podman
//   - slurm_podman: SLURM cluster with Podman
profiles {
    docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.executor = 'local'
        cleanup = false
    }

    singularity {
        singularity {
            enabled    = true
            autoMounts = true
        }
        process {
            executor  = 'local'
            container = 'oras://ghcr.io/shians/lupus-workflow-container:latest-singularity'
        }
        cleanup = false
    }

    slurm_docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.executor = 'slurm'
        cleanup = false
    }

    slurm_singularity {
        singularity {
            enabled    = true
            autoMounts = true
        }
        process {
            executor  = 'slurm'
            container = 'oras://ghcr.io/shians/lupus-workflow-container:latest-singularity'
        }
        cleanup = false
    }

    podman {
        podman {
            enabled = true
        }
        process.executor = 'local'
        cleanup = false
    }

    slurm_podman {
        podman {
            enabled = true
        }
        process.executor = 'slurm'
        cleanup = false
    }
}

manifest.defaultBranch = 'main'
