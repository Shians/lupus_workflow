{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/shians/lupus-workflow/main/nextflow_schema.json",
    "title": "Lupus Workflow Parameters",
    "description": "Single-cell RNA-seq analysis pipeline for Oxford Nanopore data",
    "type": "object",
    "defs": {
        "input_options": {
            "title": "Input Options",
            "type": "object",
            "fa_icon": "fas fa-arrow-right",
            "properties": {
                "sample_sheet": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to TSV file with sample_id and bam_dir columns listing BAM directories per sample.",
                    "fa_icon": "fas fa-table"
                },
                "reference_genome": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to reference genome FASTA file for splice alignment.",
                    "fa_icon": "fas fa-dna"
                },
                "reference_transcriptome": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to reference transcriptome FASTA file for transcript quantification.",
                    "fa_icon": "fas fa-dna"
                },
                "canonical_barcode_list": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to canonical barcode list file for 10X barcode correction.",
                    "fa_icon": "fas fa-barcode"
                },
                "snp_annotation": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to VCF file with SNP positions for CellSNP genotyping. Enables genotyping when provided.",
                    "fa_icon": "fas fa-map-marker-alt"
                },
                "vireo_sample_sheet": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to Vireo sample sheet TSV with sample_id and n_donors columns. Enables donor demultiplexing when provided alongside --snp_annotation.",
                    "fa_icon": "fas fa-users"
                }
            },
            "required": ["sample_sheet", "reference_genome", "reference_transcriptome", "canonical_barcode_list"]
        },
        "output_options": {
            "title": "Output Options",
            "type": "object",
            "fa_icon": "fas fa-folder-open",
            "properties": {
                "output_dir": {
                    "type": "string",
                    "default": "output",
                    "description": "Directory for pipeline output files.",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "alignment_options": {
            "title": "Alignment Options",
            "type": "object",
            "fa_icon": "fas fa-align-left",
            "properties": {
                "bam_parts": {
                    "type": "integer",
                    "default": 32,
                    "minimum": 1,
                    "description": "Number of chunks to split each FASTQ into for parallel alignment.",
                    "fa_icon": "fas fa-puzzle-piece"
                }
            }
        },
        "deduplication_options": {
            "title": "Deduplication Options",
            "type": "object",
            "fa_icon": "fas fa-clone",
            "properties": {
                "dedup_method": {
                    "type": "string",
                    "default": "nailpolish",
                    "description": "Deduplication method: 'nailpolish' performs molecular (CB+UMI) consensus dedup at the FASTQ level before alignment; 'umitools' runs legacy post-alignment position-based dedup on the genome and transcriptome BAMs.",
                    "fa_icon": "fas fa-clone",
                    "enum": ["nailpolish", "umitools"]
                }
            }
        },
        "barcode_detection_options": {
            "title": "Barcode Detection Options",
            "type": "object",
            "fa_icon": "fas fa-barcode",
            "properties": {
                "min_barcode_count": {
                    "type": "integer",
                    "default": 500,
                    "minimum": 1,
                    "description": "Minimum read count for a barcode to be retained.",
                    "fa_icon": "fas fa-filter"
                },
                "chemistry": {
                    "type": "string",
                    "description": "10X Chromium chemistry version.",
                    "fa_icon": "fas fa-flask",
                    "enum": ["3v1", "3v2", "3v3", "3v3.1", "3v4", "5v1", "5v2", "5v3"]
                }
            },
            "required": ["chemistry"]
        },
        "publish_options": {
            "title": "Publishing Options",
            "type": "object",
            "fa_icon": "fas fa-save",
            "properties": {
                "publish_fastq": {
                    "type": "boolean",
                    "default": false,
                    "description": "Save BAM to FASTQ converted files.",
                    "fa_icon": "fas fa-save"
                },
                "publish_retagged_fastq": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save retagged FASTQ files with barcode and UMI tags.",
                    "fa_icon": "fas fa-save"
                },
                "publish_flexiplex_candidates": {
                    "type": "boolean",
                    "default": false,
                    "description": "Save individual barcode candidate files per sample.",
                    "fa_icon": "fas fa-save"
                },
                "publish_flexiplex_merged": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save merged barcode list across all samples.",
                    "fa_icon": "fas fa-save"
                },
                "publish_flexiplex_logs": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save Flexiplex tagging log files.",
                    "fa_icon": "fas fa-save"
                },
                "publish_splice_aligned": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save splice-aligned BAM files.",
                    "fa_icon": "fas fa-save"
                },
                "publish_bam_dedup": {
                    "type": "boolean",
                    "default": false,
                    "description": "Save UMI-deduplicated BAM files (umitools mode).",
                    "fa_icon": "fas fa-save"
                },
                "publish_dedup_fastq": {
                    "type": "boolean",
                    "default": false,
                    "description": "Save nailpolish-deduplicated FASTQ files (nailpolish mode).",
                    "fa_icon": "fas fa-save"
                },
                "publish_oarfish": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save Oarfish quantification results.",
                    "fa_icon": "fas fa-save"
                },
                "publish_cell_snp": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save CellSNP genotyping results.",
                    "fa_icon": "fas fa-save"
                },
                "publish_vireo": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save Vireo demultiplexing results.",
                    "fa_icon": "fas fa-save"
                },
                "publish_qc_cramino": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save Cramino long-read stats JSON files.",
                    "fa_icon": "fas fa-save"
                },
                "publish_qc_flagstat": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save samtools flagstat mapping statistics.",
                    "fa_icon": "fas fa-save"
                },
                "publish_qc_mosdepth": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save Mosdepth genome coverage files.",
                    "fa_icon": "fas fa-save"
                },
                "publish_qc_dedup_logs": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save UMI-tools deduplication log files.",
                    "fa_icon": "fas fa-save"
                },
                "publish_qc_knee_plots": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save Flexiplex barcode knee plot PNG files.",
                    "fa_icon": "fas fa-save"
                },
                "publish_qc_read_tracking": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save per-sample read tracking TSV files.",
                    "fa_icon": "fas fa-save"
                },
                "publish_qc_multiqc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save MultiQC aggregated HTML report.",
                    "fa_icon": "fas fa-save"
                }
            }
        }
    },
    "allOf": [
        { "$ref": "#/defs/input_options" },
        { "$ref": "#/defs/output_options" },
        { "$ref": "#/defs/alignment_options" },
        { "$ref": "#/defs/deduplication_options" },
        { "$ref": "#/defs/barcode_detection_options" },
        { "$ref": "#/defs/publish_options" }
    ]
}
